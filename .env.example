# P6 Google (one connection for Business Profile and Calendar). Both providers are OFF unless set.
# MOVA_GOOGLE_PROVIDER: unset (off), fake (sandbox, never reaches Google) or live (needs MOVA_GOOGLE_LIVE_ENABLED=true).
MOVA_GOOGLE_PROVIDER=
MOVA_GOOGLE_LIVE_ENABLED=false
# Unsplash profile covers. Same rule: unset (off), fake (labelled sample photos) or live (needs the key).
MOVA_UNSPLASH_PROVIDER=
MOVA_UNSPLASH_LIVE_ENABLED=false
UNSPLASH_ACCESS_KEY=
# PricePilot source discovery and extraction. Keep server-side; never use a VITE_ prefix.
# Discovery: Claude Haiku 5.5 primary, least-cost OpenAI web-search-capable model as fallback.
# Geographic matching uses only explicit public menu addresses and stylist location postal/region fields; no geocoding key is required.
MOVA_PRICE_PILOT_PRIMARY_PROVIDER=anthropic
MOVA_PRICE_PILOT_PRIMARY_MODEL=claude-haiku-5-5
MOVA_PRICE_PILOT_FALLBACK_PROVIDER=openai
MOVA_PRICE_PILOT_FALLBACK_MODEL=gpt-6-luna
MOVA_PRICE_PILOT_MAX_SEARCH_CALLS=5
FIRECRAWL_API_KEY=
OPERATOR_BASE_URL=https://mova-beauty.co

# AI providers (server-only; never use a VITE_ prefix).
MOVA_AI_PRIMARY_PROVIDER=anthropic
MOVA_AI_FALLBACK_PROVIDER=openai
MOVA_ANTHROPIC_API_KEY=
MOVA_OPENAI_API_KEY=
# PricePilot competitor profiles (Google Places API New; server-only).
MOVA_GOOGLE_PLACES_API_KEY=
