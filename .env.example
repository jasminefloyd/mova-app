# Supabase client configuration (safe for the browser when using the publishable/anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MOVA_EMAIL_FROM=
MOVA_LOG_ALERT_EMAIL=
