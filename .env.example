# Supabase client configuration (safe for the browser when using the publishable/anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLIENT_PROFILES_ENABLED=false
VITE_WALLET_CLIENT_CARD_ENABLED=false
VITE_CONCIERGE_WEB_CHAT_ENABLED=false
VITE_STRIPE_TEST_MODE=false

# Canonical public website origin used for metadata, robots.txt, and sitemap.xml.
PUBLIC_BASE_URL=https://mova-beauty.co

# Supabase CLI project references (identifiers, not credentials).
SUPABASE_PROJECT_REF_DEV=
SUPABASE_PROJECT_REF_PROD=

# Deployment tooling credentials. Keep values in the ignored .env file or secret store.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Server-only Supabase credentials. Never expose these with a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
CRON_SECRET=
MOVA_JOB_DISPATCH_SECRET=
MOVA_JOB_WORKER_SECRET=
MOVA_DOOR_CODE_KEK_HEX=
MOVA_NOTES_KEK_HEX=
MOVA_PROVIDER_TOKENS_KEK_HEX=
MOVA_CLIENT_CARD_TOKENS_HMAC_HEX=
MOVA_MESSAGING_WEBHOOK_SECRET=
MOVA_NOTIFICATION_DISPATCH_SECRET=
MOVA_STRIPE_TEST_MODE=false
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_REDIRECT_URI=
STRIPE_WEBHOOK_SECRET=
MOVA_MESSAGING_LIVE_SMS=false
MOVA_MESSAGING_LIVE_EMAIL=false
MOVA_CONCIERGE_WEB_CHAT_ENABLED=false
MOVA_CLIENT_PROFILES_ENABLED=false
MOVA_WALLET_CLIENT_CARD_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# P6 Google (one connection for Business Profile and Calendar). Both providers are OFF unless set.
# MOVA_GOOGLE_PROVIDER: unset (off), fake (sandbox, never reaches Google) or live (needs MOVA_GOOGLE_LIVE_ENABLED=true).
MOVA_GOOGLE_PROVIDER=
MOVA_GOOGLE_LIVE_ENABLED=false
# Unsplash profile covers. Same rule: unset (off), fake (labelled sample photos) or live (needs the key).
MOVA_UNSPLASH_PROVIDER=
MOVA_UNSPLASH_LIVE_ENABLED=false
UNSPLASH_ACCESS_KEY=
OPERATOR_BASE_URL=https://ops.mova-beauty.co

# AI providers (server-only; leave disabled until A-04 evaluation and spend controls are approved).
MOVA_AI_PRIMARY_PROVIDER=anthropic
MOVA_AI_FALLBACK_PROVIDER=openai
MOVA_ANTHROPIC_API_KEY=
MOVA_OPENAI_API_KEY=
