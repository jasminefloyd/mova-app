{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "react-router",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build",
  "crons": [
    {
      "path": "/api/booking-expiry",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/job-dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/calendar-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/reports-refresh",
      "schedule": "17 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/admin/__manifest",
      "has": [
        {
          "type": "host",
          "value": "admin.mova-beauty.co"
        }
      ],
      "destination": "/__manifest",
      "permanent": false
    },
    {
      "source": "/admin/manifest.webmanifest",
      "has": [
        {
          "type": "host",
          "value": "admin.mova-beauty.co"
        }
      ],
      "destination": "/manifest.webmanifest",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.mova-beauty.co"
        }
      ],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/:path((?!admin(?:/|$)|assets/|api/|icons/|favicon|__manifest|manifest\\.webmanifest|robots\\.txt|sitemap\\.xml).+)",
      "has": [
        {
          "type": "host",
          "value": "admin.mova-beauty.co"
        }
      ],
      "destination": "/admin/:path",
      "permanent": false
    }
  ]
}
