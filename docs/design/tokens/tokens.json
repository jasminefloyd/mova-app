{
  "$description": "Mova design tokens (source of truth for packages/design-tokens). Values come from spec §2.5 / D-10 and were checked against every canvas artboard. Format follows the W3C Design Tokens draft ($value/$type).",
  "color": {
    "brand": {
      "forest":     { "$value": "#18392F", "$type": "color", "$description": "Primary brand, primary buttons, headings, dark cards" },
      "botanical":  { "$value": "#264E3E", "$type": "color", "$description": "Secondary green, links on hover, first location colour" },
      "sage":       { "$value": "#8BA990", "$type": "color", "$description": "Toggle track (on, dark surfaces), dashed guides" },
      "mint":       { "$value": "#C9E6D4", "$type": "color", "$description": "Confirmed chips, active tab pill, text on forest" },
      "peach":      { "$value": "#E7C3AA", "$type": "color", "$description": "Accent, avatar placeholder fill" },
      "ivory":      { "$value": "#F7F5EF", "$type": "color", "$description": "App background, text on forest" }
    },
    "ink": {
      "primary":    { "$value": "#18392F", "$type": "color", "$description": "Body text" },
      "secondary":  { "$value": "#3F4D46", "$type": "color", "$description": "Secondary text (≥4.5:1 on ivory)" },
      "muted":      { "$value": "#4F5F57", "$type": "color", "$description": "Captions, metadata (≥4.5:1 on ivory)" },
      "tab-inactive": { "$value": "#55655D", "$type": "color", "$description": "Inactive tab bar labels and icons" },
      "inverse":    { "$value": "#F7F5EF", "$type": "color" },
      "danger":     { "$value": "#9A3B2E", "$type": "color", "$description": "Destructive actions (Cancel, Sign out), errors" }
    },
    "surface": {
      "page":       { "$value": "#F7F5EF", "$type": "color" },
      "card":       { "$value": "#FFFFFF", "$type": "color" },
      "alt":        { "$value": "#EEF3EC", "$type": "color", "$description": "Empty photo guides, quiet panels" },
      "inverse":    { "$value": "#18392F", "$type": "color", "$description": "Dark cards (client card, autopilot on, settings header)" },
      "warm":       { "$value": "#F3E3D6", "$type": "color", "$description": "Before you start, pending/request highlights" },
      "scrim":      { "$value": "#3B4A43", "$type": "color", "$description": "Backdrop behind sheets (18, 27, 44)" }
    },
    "line": {
      "default":    { "$value": "#DCE1D9", "$type": "color", "$description": "Card borders" },
      "subtle":     { "$value": "#EBEEE8", "$type": "color", "$description": "Row dividers inside cards" },
      "control":    { "$value": "#C8CFC5", "$type": "color", "$description": "Secondary buttons, inputs, unselected options" },
      "bar":        { "$value": "#E2E5DE", "$type": "color", "$description": "Top border of tab bar and sticky action bars" },
      "step-off":   { "$value": "#D5DBD2", "$type": "color", "$description": "Inactive onboarding step segments" }
    },
    "accent": {
      "warm":        { "$value": "#F3E3D6", "$type": "color" },
      "warm-strong": { "$value": "#C98F66", "$type": "color", "$description": "Decorative and large text only (stars, unread dots, avatar figure). Not for body text." }
    },
    "status": {
      "confirmed-bg": { "$value": "#C9E6D4", "$type": "color", "$description": "Always with check icon + text" },
      "confirmed-fg": { "$value": "#18392F", "$type": "color" },
      "pending-bg":   { "$value": "#F3E3D6", "$type": "color", "$description": "Always with dashed border + clock icon + text" },
      "pending-border": { "$value": "#C98F66", "$type": "color" },
      "pending-fg":   { "$value": "#18392F", "$type": "color" }
    },
    "location": {
      "1": { "$value": "#264E3E", "$type": "color", "$description": "First location. Always shown next to the location name." },
      "2": { "$value": "#C98F66", "$type": "color", "$description": "Second location. Further colours need an approved extension list." }
    },
    "third-party": {
      "wallet-button": { "$value": "#111111", "$type": "color", "$description": "Placeholder for official Apple/Google Wallet badges. Use the providers' official artwork (A-06/A-19)." }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Manrope, sans-serif", "$type": "fontFamily", "$description": "Weights 600, 700, 800 (headings, numbers)" },
      "ui":      { "$value": "'DM Sans', sans-serif", "$type": "fontFamily", "$description": "Weights 400, 500, 600, 700 (everything else)" }
    },
    "size": {
      "display-xl": { "$value": "28px", "$type": "dimension", "$description": "Screen titles (h1), Manrope 800, letter-spacing -0.4px" },
      "display-l":  { "$value": "26px", "$type": "dimension" },
      "display-home": { "$value": "24px", "$type": "dimension", "$description": "Home greeting" },
      "display-m":  { "$value": "20px", "$type": "dimension", "$description": "Card titles, amounts" },
      "display-s":  { "$value": "17px", "$type": "dimension" },
      "body-l":     { "$value": "16px", "$type": "dimension", "$description": "Inputs (never below 16px to avoid iOS zoom), primary buttons" },
      "body":       { "$value": "15px", "$type": "dimension" },
      "body-s":     { "$value": "14px", "$type": "dimension", "$description": "Most UI text" },
      "caption":    { "$value": "13px", "$type": "dimension" },
      "micro":      { "$value": "12px", "$type": "dimension" },
      "tab":        { "$value": "11px", "$type": "dimension", "$description": "Tab bar labels, overlines" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }, "extrabold": { "$value": 800 } }
  },
  "radius": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "s":  { "$value": "10px", "$type": "dimension" },
    "m":  { "$value": "12px", "$type": "dimension", "$description": "Chips, small tiles" },
    "l":  { "$value": "14px", "$type": "dimension", "$description": "Option buttons, inputs" },
    "xl": { "$value": "18px", "$type": "dimension", "$description": "List cards" },
    "2xl": { "$value": "20px", "$type": "dimension", "$description": "Content cards" },
    "3xl": { "$value": "28px", "$type": "dimension", "$description": "Sheets, hero cards" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "Buttons are pills: radius = height / 2" }
  },
  "space": {
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px", "$description": "Page gutter" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }
  },
  "size": {
    "tap-min":         { "$value": "44px", "$description": "Minimum touch target" },
    "button-primary":  { "$value": "54px" },
    "button-secondary": { "$value": "46px" },
    "button-compact":  { "$value": "40px" },
    "chip":            { "$value": "36px" },
    "input":           { "$value": "52px", "$description": "Text inputs; option buttons in radio groups are 48px" },
    "tab-bar":         { "$value": "82px", "$description": "Includes bottom safe area" },
    "avatar-showcase": { "$value": "104px" },
    "screen-width-ref": { "$value": "390px", "$description": "Canvas reference width; layouts must work 320–430px" }
  },
  "shadow": {
    "raised": { "$value": "0 8px 20px rgba(24,57,47,0.15)", "$description": "Floating action button, raised cards" },
    "sheet":  { "$value": "0 18px 40px rgba(0,0,0,0.25)" }
  },
  "motion": {
    "duration-fast": { "$value": "150ms" },
    "duration-base": { "$value": "250ms" },
    "easing":        { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "$description": "Proposed (not on the canvas). Honour prefers-reduced-motion: no movement, opacity changes only."
  }
}
